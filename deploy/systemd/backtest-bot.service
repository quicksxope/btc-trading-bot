[Unit]
Description=Agnostic backtest Telegram bot
After=network-online.target backtest-worker.service

[Service]
Type=simple
User=user
WorkingDirectory=/home/user/agnostic-trading-backtest
EnvironmentFile=/home/user/agnostic-trading-backtest/.env
ExecStart=/home/user/agnostic-trading-backtest/.venv/bin/backtest-bot
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
